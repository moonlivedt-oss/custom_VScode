{
  // ============================================================
  //  Проверка типов БЕЗ перехода на TypeScript.
  //
  //  Рантайм остаётся обычным ES5-джаваскриптом: tsc ничего не собирает (noEmit) и ничего
  //  не кладёт в custom-bg.js. TypeScript живёт только как dev-зависимость и работает
  //  проверяющим: модули из src/** склеиваются в одну область видимости, и до сих пор
  //  связи между ними ничем не проверялись — потерянная при переносе переменная всплывала
  //  только на смоук-тесте как ReferenceError в рантайме.
  //
  //  Почему это работает без import/export: файл .js без import/export для TypeScript —
  //  СКРИПТ, а не модуль, и все такие файлы делят одно глобальное пространство имён. То есть
  //  ровно та же модель, что и у нашей склейки в один IIFE.
  //
  //  Запуск:  npm run typecheck   (входит в npm run check)
  // ============================================================
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Строгость подобрана под живой код, а не под идеальный: включено то, что ловит
    // настоящие ошибки, и выключено то, что в защитном коде с try/catch даёт только шум.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": false,

    // А вот это — ровно те проверки, ради которых всё затевалось.
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    // Никаких @types из node_modules: рантайм живёт в браузере, а установленный для
    // инструментов @types/node иначе подменяет глобалы (setTimeout начинает возвращать
    // NodeJS.Timeout вместо number).
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // Только рантайм-модули: у них общая область видимости, как в собранном файле.
  // Инструменты (build.js, scripts/**, test/**) — это CommonJS-модули с require, у них
  // другая модель; они проверяются отдельным прогоном (tsconfig.tools.json).
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
