{
  "name": "moonlight-custom-bg",
  "version": "20.0.0",
  "description": "Кастомный фон и панель оформления для VS Code: картинки по зонам, наборы с палитрой, слайдшоу, живые эффекты, шейдерные фоны и движок читаемости. Грузится через be5invis.vscode-custom-css или subframe7536.custom-ui-style.",
  "author": "moonlivedt (MoonLightDeath) <moonlivedt@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "custom-bg.js",
  "files": [
    "custom-bg.js",
    "src",
    "assets"
  ],
  "scripts": {
    "build": "node build.js",
    "build:min": "node build.js --min",
    "build:themes": "node build-themes.js",
    "test": "node test/smoke.js",
    "test:e2e": "node build.js && playwright test",
    "screenshots": "node build.js && node scripts/screenshots.js",
    "check": "node build.js && node test/smoke.js && node scripts/lint-dead.js && npm run typecheck",
    "setup": "node install.js",
    "hooks": "git config core.hooksPath hooks",
    "import-master": "node scripts/import-master.js",
    "lint:dead": "node scripts/lint-dead.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "analyze": "python scripts/analyze_sets.py --crops",
    "analyze:sheet": "python scripts/analyze_sets.py --sheet",
    "test:visual": "node build.js && playwright test test/visual.spec.js",
    "test:visual:update": "node build.js && playwright test test/visual.spec.js --update-snapshots",
    "package": "node scripts/package-extension.js"
  },
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moonlivedt-oss/custom_VScode.git"
  },
  "keywords": [
    "vscode",
    "custom-css",
    "background",
    "theme",
    "be5invis"
  ],
  "//devDependencies": "Только для интеграционного теста (npm run test:e2e). Основной поток (build + smoke) зависимостей НЕ требует; ставь эту dev-зависимость лишь для e2e.",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.136.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  }
}
