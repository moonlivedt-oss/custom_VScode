{
  // Инструменты вокруг проекта: сборщик, скрипты, тесты, компаньон-расширение. У них другая
  // модель, чем у рантайма: это CommonJS-модули с require и своей областью видимости, поэтому
  // отдельный проход — иначе их глобалы смешались бы с общей областью склеиваемых модулей.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["build.js", "scripts/**/*.js", "test/**/*.js", "extension/*.js", "types/**/*.d.ts"]
}
