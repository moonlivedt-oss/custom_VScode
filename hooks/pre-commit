#!/bin/sh
# ============================================================
#  MoonLight custom-bg — pre-commit hook.
#  Держит custom-bg.js собранным из src/ и не даёт закоммитить с падающим smoke.
#  То же самое проверяет CI (.github/workflows/ci.yml) — hook ловит это ЛОКАЛЬНО,
#  до пуша, и сам до-добавляет пересобранный артефакт в коммит.
#
#  Установка (один раз):  npm run hooks   (ставит core.hooksPath=hooks)
# ============================================================
set -e

# Пересобрать артефакт из src/.
node build.js

# Прогнать смоук-тест; падает — коммит останавливается.
if ! node test/smoke.js; then
  echo "pre-commit: smoke-тест упал — коммит остановлен. Почини тест/код и повтори." 1>&2
  exit 1
fi

# Если сборка изменила custom-bg.js (кто-то правил src, но не пересобрал) — до-добавляем
# свежий артефакт в этот же коммит, чтобы в истории src и сборка всегда совпадали.
if ! git diff --quiet -- custom-bg.js; then
  git add custom-bg.js
  echo "pre-commit: custom-bg.js пересобран из src/ и добавлен в коммит."
fi
